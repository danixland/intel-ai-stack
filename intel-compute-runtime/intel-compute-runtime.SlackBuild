#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=intel-compute-runtime
SRCNAM=compute-runtime
VERSION=${VERSION:-26.09.37435.1}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -ex

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $SRCNAM-$VERSION
tar xvf $CWD/$PRGNAM-$VERSION.tar.gz
cd $SRCNAM-$VERSION

chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

patch -Np1 -i $CWD/010-intel-compute-runtime-disable-werror.patch

# Fix runtime error in blender (upstream recommendation)
export CFLAGS="$SLKCFLAGS -DSANITIZER_BUILD=1"
export CXXFLAGS="$SLKCFLAGS -DSANITIZER_BUILD=1"

# Upstream forces _FORTIFY_SOURCE=2; avoid redefinition warnings
export CFLAGS="${CFLAGS/-D_FORTIFY_SOURCE=?/}"
export CXXFLAGS="${CXXFLAGS/-D_FORTIFY_SOURCE=?/}"

# Use bundled opencl-headers (upstream pins a specific version)
_opencl_headers_dir="$TMP/$SRCNAM-$VERSION/third_party/opencl_headers"
export CXXFLAGS="$CXXFLAGS -isystem${_opencl_headers_dir}"

# Parse version components
_ver_major="${VERSION%%.*}"
_ver_minor="$(echo $VERSION | cut -d. -f2)"
_ver_build="$(echo $VERSION | cut -d. -f3)"

mkdir -p build
cd build
  cmake .. \
    -G "Unix Makefiles" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib${LIBDIRSUFFIX} \
    -DNEO_BUILD_UNVERSIONED_OCLOC=ON \
    -DNEO_DISABLE_LD_GOLD:BOOL=ON \
    -DNEO_OCL_VERSION_MAJOR="${_ver_major}" \
    -DNEO_OCL_VERSION_MINOR="${_ver_minor}" \
    -DNEO_VERSION_BUILD="${_ver_build}" \
    -DKHRONOS_GL_HEADERS_DIR=/usr/include \
    -DKHRONOS_HEADERS_DIR="${_opencl_headers_dir}" \
    -Wno-dev
  make
  make install DESTDIR=$PKG
cd ..

rm -f $PKG/{,usr/}lib${LIBDIRSUFFIX}/*.la

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

# Register OpenCL ICD with full path since the library installs
# to a non-standard subdirectory
mkdir -p $PKG/etc/OpenCL/vendors
echo "/usr/lib${LIBDIRSUFFIX}/intel-opencl/libigdrcl.so" > $PKG/etc/OpenCL/vendors/intel.icd

# libze_intel_gpu compat symlink
_ze_so=$(find $PKG/usr/lib${LIBDIRSUFFIX} -regex '.*libze_intel_gpu.so.[0-9]*' \
  -exec basename {} \; 2>/dev/null | head -1)
[ -n "$_ze_so" ] && ln -sf $_ze_so $PKG/usr/lib${LIBDIRSUFFIX}/libze_intel_gpu.so || true

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a LICENSE.md $PKG/usr/doc/$PRGNAM-$VERSION/
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
